# app-int -- environment variable reference for running Dark Factory
# against this repository. Copy this file to `.env` and fill in real values.
# `.env` is git-ignored -- never commit it, never paste real values here.

# --- Dark Factory's own run-state database (your Neon project) -------------

# Pooled Neon connection string (host contains "-pooler") -- used by the
# application at runtime. Rewrite the scheme to postgresql+psycopg://.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@ep-example-000000-pooler.us-east-2.aws.neon.tech/dbname

# Direct (non-pooled) Neon connection string (host WITHOUT "-pooler") -- used
# by Alembic only, because DDL and PgBouncer transaction pooling do not mix.
DATABASE_URL_DIRECT=postgresql+psycopg://USER:PASSWORD@ep-example-000000.us-east-2.aws.neon.tech/dbname

# --- GitHub credentials -----------------------------------------------------

# Dark Factory's own comment/PR/read credential -- reads issues, posts
# clarification comments, creates pull requests, and (via its own
# authenticated_login() self-heal check) calls GET /user, which GitHub's
# reserved Actions auto-token (secrets.GITHUB_TOKEN) can never do regardless
# of permissions scoping. Must therefore be a real PAT, not the CI job's
# ambient token. Classic PAT with `repo` scope, or a fine-grained PAT scoped
# to this repo with Contents (read/write), Issues (read/write), and Pull
# requests (read/write) permissions.
DARK_FACTORY_GITHUB_TOKEN=

# --- Worker runtime credential(s) -------------------------------------------

# Required by: BA (claude-code), ARCHITECTURE (claude-code), DEVELOPMENT (claude-code), QA (claude-code).
ANTHROPIC_API_KEY=

# --- Optional -----------------------------------------------------------

LOG_LEVEL=INFO
